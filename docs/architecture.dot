digraph CLAWHunter {
    // Source-of-truth diagram for both docs/architecture.svg and the README PNG.
    graph [rankdir=TB, bgcolor="#0d1117", fontcolor="#e6edf3", fontname="Helvetica", label="CLAWHunter v3.3.0 Architecture", labelloc=t, pad=0.5]
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontcolor="#e6edf3", color="#484f58", fillcolor="#161b22"]
    edge [color="#8b949e", fontcolor="#8b949e", fontname="Helvetica"]

    // Entry points match the official Hak5 Payload Library category hierarchy.
    user [label="User / reconnaissance\nInteractive scan + result browser", color="#58a6ff"]
    recon [label="Recon / access_point\nSelected AP + 2.4 GHz client", color="#58a6ff"]
    alert [label="Alert / pineapple_client_connected\nExact triggering client + fast probe", color="#58a6ff"]
    // Shared behavior belongs here so Recon, alert, and interactive evidence
    // semantics cannot drift independently.
    common [label="lib/common.sh\nValidation, evidence scoring, mDNS, ARP, hardware, reports", color="#3fb950", penwidth=2]
    // Discovery separates unauthenticated hints and IP families before probes.
    discovery [label="Discovery\n_openclaw-gw._tcp hints\nIPv4 ARP/ping hosts\nIPv6 link-local candidates", color="#d29922"]
    // The classifier is the only component allowed to create confirmed results.
    probe [label="Classifier\nTCP + HTTP/S + health/readiness\nWebSocket + connect.challenge\nCONFIRMED / LIKELY / CANDIDATE", color="#d29922"]
    // Assessment is an explicit action and never participates in discovery.
    harvest [label="harvest.py\n180s ceiling\nCurrent HTTP/WS evidence\nAuthorized read-only tool calls", color="#a371f7"]
    // All persistence stays local to the standard Pager loot tree.
    output [label="/root/loot/clawhunter\nLogs, JSON, harvest reports, watchdog state"]

    // Data flow ends in local Pager loot; no remote staging/exfiltration exists.
    {rank=same; user; recon; alert}
    user -> common
    recon -> common
    alert -> common
    // Shared flow: gather candidates, classify evidence, then persist locally.
    common -> discovery
    discovery -> probe
    probe -> output
    probe -> harvest [label="confirmed result"]
    harvest -> output
}
